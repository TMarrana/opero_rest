# Copiar para .env e preencher. O .env nunca entra no git.

# Obrigatório em produção; em dev há um default inseguro.
DJANGO_SECRET_KEY=

# dev: config.settings.dev · prod: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Vazio em dev (usa SQLite). Em produção: postgres://user:pass@host:5432/opero
DATABASE_URL=

# Só produção, separado por vírgulas. Com subdomínios, o domínio com ponto
# à frente aceita todos: .opero.pt
DJANGO_ALLOWED_HOSTS=

# Domínio base dos grupos: cada um entra em <endereço>.opero.pt. Vazio em
# dev: tudo num só endereço. Para testar subdomínios em dev, localtest.me
# aponta todos os subdomínios para 127.0.0.1:
#   OPERO_BASE_DOMAIN=localtest.me
#   DJANGO_EXTRA_HOSTS=.localtest.me
# e abrir http://<endereço>.localtest.me:8000/
OPERO_BASE_DOMAIN=

# Teste da PWA no telemovel via tunel HTTPS (so dev).
# O runserver arranca em 127.0.0.1:8001, logo: ssh -R 80:127.0.0.1:8001 nokey@localhost.run
# DJANGO_EXTRA_HOSTS=abc-def.trycloudflare.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://abc-def.trycloudflare.com
